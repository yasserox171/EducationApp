# ------------------------------------------------------------------
# انسخ هذا الملف إلى .env ثم عدّل القيم.
#   cp .env.example .env
# ملف .env غير مرفوع إلى المستودع (موجود في .gitignore).
# ------------------------------------------------------------------

# عنوان الـ Backend API الأساسي (بدون / في الآخر).
# مثال: https://api.mon-centre.dz/v1
BASE_URL=

# مهلات الاتصال (بالثواني / بالدقائق للرفع)
CONNECT_TIMEOUT_SECONDS=20
RECEIVE_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_MINUTES=30

# الحد الأقصى لحجم ملف الفيديو الذي يستطيع الأستاذ رفعه (ميغابايت)
MAX_VIDEO_UPLOAD_MB=300

# الحد الأقصى الإجمالي للفيديوهات المحمّلة على الجهاز (ميغابايت)
# يُستعمل للتنبيه قبل تحميل درس جديد.
MAX_OFFLINE_STORAGE_MB=4096

# طباعة تفاصيل طلبات HTTP في وضع التطوير (true/false)
VERBOSE_HTTP_LOGS=false
